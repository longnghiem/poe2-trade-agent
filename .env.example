# Local Postgres (used by compose.yml and the backend)
POSTGRES_USER=poe2_trade_agent
POSTGRES_PASSWORD=poe2
POSTGRES_DB=poe2_trade_templates

# Backend database connection. "postgresql+psycopg" means PostgreSQL through the psycopg 3 driver.
# Port 5433 is the port compose.yml publishes on your computer.
DATABASE_URL=postgresql+psycopg://poe2_trade_agent:poe2@localhost:5433/poe2_trade_templates

# Secret for signing login tokens (JWT). Make your own with:
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-random-secret-of-32-or-more-characters